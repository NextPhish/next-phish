DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=next_phish
# Prisma reads this URL directly; DB_* values do not automatically construct it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_phish
# Optional Prisma pool size (connections)
# DB_CONNECTION_LIMIT=10

# Next.js uses PORT (or its --port CLI option), not APP_PORT.
PORT=3000
STATIC_SERVER_PORT=3001
# Neutral public host used in recipient-facing content (must not identify the platform)
PUBLIC_CONTENT_URL=http://localhost:3001
MESSAGE_ID_DOMAIN=mail.example.com
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For
TRUSTED_PROXY_NETWORKS=
# HMAC secret used to authenticate technical provider event callbacks
DELIVERY_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

BETTER_AUTH_SECRET=replace-with-a-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.test

# Redis connection (used for BullMQ queues and pub/sub events)
REDIS_HOST=localhost
REDIS_PORT=6379

# Campaign execution worker controls
DELIVERY_ENABLED=true
SCHEDULE_POLL_INTERVAL_MS=10000
SCHEDULE_CLAIM_BATCH=50
MATERIALIZATION_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=5000
DELIVERY_FEED_INTERVAL_MS=10000
DELIVERY_HORIZON_MINUTES=5
DELIVERY_FEED_BATCH=500
DELIVERY_CONCURRENCY=10
DELIVERY_RATE_MAX=60
DELIVERY_RATE_DURATION_MS=60000
ORGANIZATION_DELIVERY_RATE_MAX=600
PROVIDER_DELIVERY_RATE_MAX=300
PROFILE_DELIVERY_RATE_MAX=120
SMTP_MAX_CONNECTIONS=5
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_EVENT_RETENTION_DAYS=90
DELIVERY_ATTEMPT_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=7
EXECUTION_MAINTENANCE_INTERVAL_MS=86400000

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=next-phish-development

# Encryption key for page form submissions (64-char hex = 256-bit)
# Generate with: openssl rand -hex 32
PAGE_SUBMISSION_ENCRYPTION_KEY=replace-with-a-64-character-hex-key

# Personal Access Token rate limiting (optional, defaults shown)
# PAT_RATE_LIMIT_MAX_REQUESTS=1000
# PAT_RATE_LIMIT_TIME_WINDOW=3600000
