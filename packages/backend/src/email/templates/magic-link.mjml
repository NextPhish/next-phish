<mj-text>Hi there,</mj-text>
<mj-text>Use the secure link below to sign in to your account. This link expires in 5 minutes.</mj-text>
<mj-button href="<%= url %>">Sign in</mj-button>
<mj-divider />
<mj-text color="#626d80" font-size="13px">If you did not request this link, you can safely ignore this email.</mj-text>
<mj-text color="#626d80" font-size="12px" css-class="fallback">If the button does not work, copy this link into your browser:<br/><a href="<%= url %>"><%= url %></a></mj-text>
