<mjml lang="en">
  <mj-head>
    <mj-title><%= title %></mj-title>
    <mj-preview><%= preview %></mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#192235" font-size="15px" line-height="1.7" padding="0 0 18px" />
      <mj-button background-color="#5146d9" color="#ffffff" font-weight="600" font-size="15px" border-radius="7px" inner-padding="14px 24px" padding="10px 0 28px" align="left" />
      <mj-divider border-color="#e5e8ef" border-width="1px" padding="10px 0 24px" />
    </mj-attributes>
    <mj-style inline="inline">.fallback a { word-break: break-all; overflow-wrap: anywhere; color: #5146d9; } .footer-link { color: #626d80; text-decoration: underline; }</mj-style>
    <mj-style>@media only screen and (max-width:480px) { .email-content > table > tbody > tr > td { padding: 28px 24px !important; } }</mj-style>
  </mj-head>
  <mj-body background-color="#f5f6fa" width="600px">
    <mj-section padding="32px 0 0"><mj-column><mj-spacer height="1px" /></mj-column></mj-section>
    <mj-section background-color="#151b2c" border-radius="12px 12px 0 0" padding="28px 32px">
      <mj-column><mj-text color="#ffffff" font-size="23px" font-weight="700" padding="0">nextphish<span style="color:#a99fff">.</span></mj-text></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="36px 32px" css-class="email-content">
      <mj-column>
        <mj-text font-size="11px" font-weight="700" color="#626d80" letter-spacing="1.4px">ACCOUNT &amp; WORKSPACE</mj-text>
        <mj-text font-size="27px" font-weight="700" line-height="1.25" padding="0 0 24px"><%= title %></mj-text>
        <%- body %>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-top="1px solid #e5e8ef" border-radius="0 0 12px 12px" padding="24px 32px">
      <mj-column><mj-text font-size="12px" color="#626d80" padding="0">NextPhish · Security awareness platform<br/><a href="<%= appUrl %>" class="footer-link">Open your workspace</a></mj-text></mj-column>
    </mj-section>
    <mj-section padding="20px 24px 32px"><mj-column><mj-text align="center" color="#626d80" font-size="11px" padding="0">This is an automated account notification from NextPhish.</mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
